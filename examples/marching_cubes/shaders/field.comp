#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, r32f) uniform writeonly image3D volumeImage;

layout(push_constant) uniform ComputePushConstants {
    float time;
    float isoLevel;
    uint resolution;
    float padding;
} pushConstants;

float metaball(vec3 position, vec3 center, float radius) {
    const vec3 offset = position - center;
    return radius * radius / (dot(offset, offset) + 0.025);
}

void main() {
    const uvec3 sampleCoordinate = gl_GlobalInvocationID.xyz;
    if (any(greaterThan(sampleCoordinate, uvec3(pushConstants.resolution)))) {
        return;
    }

    const vec3 uv = vec3(sampleCoordinate) / float(pushConstants.resolution);
    const vec3 position = mix(vec3(-1.5), vec3(1.5), uv);
    const float t = pushConstants.time;
    const vec3 center0 = vec3(0.48 * sin(t * 0.91), 0.33 * cos(t * 0.73), 0.28 * sin(t * 0.57));
    const vec3 center1 = vec3(0.42 * cos(t * 0.63 + 1.2), 0.46 * sin(t * 0.79), 0.31 * cos(t * 0.51));
    const vec3 center2 = vec3(0.37 * sin(t * 0.47 + 2.4), 0.29 * cos(t * 0.87 + 0.6),
                              0.48 * sin(t * 0.69 + 1.7));

    const float density = metaball(position, center0, 0.54) +
                          metaball(position, center1, 0.48) +
                          metaball(position, center2, 0.43);
    imageStore(volumeImage, ivec3(sampleCoordinate), vec4(density, 0.0, 0.0, 1.0));
}
