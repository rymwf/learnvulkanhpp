#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct BvhNode {
    vec4 boundsMinimum;
    vec4 boundsMaximum;
    uvec4 data;
};

struct Triangle {
    vec4 position0;
    vec4 position1;
    vec4 position2;
    vec4 normal0;
    vec4 normal1;
    vec4 normal2;
};

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(set = 0, binding = 2, std430) readonly buffer BvhNodes {
    BvhNode nodes[];
};
layout(set = 0, binding = 3, std430) readonly buffer Triangles {
    Triangle triangles[];
};
layout(set = 0, binding = 4, std430) buffer Statistics {
    uint nodeTests;
    uint triangleTests;
} statistics;

layout(push_constant) uniform RayPushConstants {
    mat4 inverseViewProjection;
    uvec4 extent;
} pushConstants;

const uint MAX_TRAVERSAL_STACK = 64;
const float RAY_EPSILON = 1.0e-5;

bool intersectBounds(vec3 origin, vec3 direction, vec3 minimum, vec3 maximum, float closestDistance,
                     out float nearDistance) {
    float farDistance = closestDistance;
    nearDistance = 0.0;
    for (int axis = 0; axis < 3; ++axis) {
        if (abs(direction[axis]) < RAY_EPSILON) {
            if (origin[axis] < minimum[axis] || origin[axis] > maximum[axis]) {
                return false;
            }
            continue;
        }

        const float inverseDirection = 1.0 / direction[axis];
        float first = (minimum[axis] - origin[axis]) * inverseDirection;
        float second = (maximum[axis] - origin[axis]) * inverseDirection;
        if (first > second) {
            const float temporary = first;
            first = second;
            second = temporary;
        }
        nearDistance = max(nearDistance, first);
        farDistance = min(farDistance, second);
        if (farDistance < nearDistance) {
            return false;
        }
    }
    return farDistance >= 0.0;
}

bool intersectTriangle(vec3 origin, vec3 direction, Triangle triangle, out float distance,
                       out vec3 barycentric) {
    const vec3 edge1 = triangle.position1.xyz - triangle.position0.xyz;
    const vec3 edge2 = triangle.position2.xyz - triangle.position0.xyz;
    const vec3 p = cross(direction, edge2);
    const float determinant = dot(edge1, p);
    if (abs(determinant) < RAY_EPSILON) {
        return false;
    }

    const float inverseDeterminant = 1.0 / determinant;
    const vec3 offset = origin - triangle.position0.xyz;
    const float u = dot(offset, p) * inverseDeterminant;
    if (u < 0.0 || u > 1.0) {
        return false;
    }

    const vec3 q = cross(offset, edge1);
    const float v = dot(direction, q) * inverseDeterminant;
    if (v < 0.0 || u + v > 1.0) {
        return false;
    }

    distance = dot(edge2, q) * inverseDeterminant;
    barycentric = vec3(1.0 - u - v, u, v);
    return distance > RAY_EPSILON;
}

vec3 backgroundColor(vec3 direction) {
    const float blend = clamp(0.5 * (direction.y + 1.0), 0.0, 1.0);
    return mix(vec3(0.018, 0.025, 0.04), vec3(0.22, 0.34, 0.48), blend);
}

void main() {
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pushConstants.extent.x || pixel.y >= pushConstants.extent.y) {
        return;
    }

    const vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(pushConstants.extent.xy);
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    const vec4 nearHomogeneous = pushConstants.inverseViewProjection * vec4(ndc, 0.0, 1.0);
    const vec4 farHomogeneous = pushConstants.inverseViewProjection * vec4(ndc, 1.0, 1.0);
    const vec3 origin = nearHomogeneous.xyz / nearHomogeneous.w;
    const vec3 direction = normalize(farHomogeneous.xyz / farHomogeneous.w - origin);

    uint localNodeTests = 1;
    uint localTriangleTests = 0;
    uint stack[MAX_TRAVERSAL_STACK];
    float nearStack[MAX_TRAVERSAL_STACK];
    float rootNearDistance;
    uint stackSize = 0;
    if (intersectBounds(origin, direction, nodes[0].boundsMinimum.xyz,
                        nodes[0].boundsMaximum.xyz, 3.402823466e+38, rootNearDistance)) {
        stack[0] = 0;
        nearStack[0] = rootNearDistance;
        stackSize = 1;
    }
    float closestDistance = 3.402823466e+38;
    uint closestTriangle = 0;
    vec3 closestBarycentric = vec3(0.0);
    bool hit = false;

    while (stackSize > 0) {
        const uint nodeIndex = stack[--stackSize];
        const float nodeNearDistance = nearStack[stackSize];
        if (nodeNearDistance > closestDistance) {
            continue;
        }
        const BvhNode node = nodes[nodeIndex];

        if (node.data.w > 0) {
            for (uint triangleOffset = 0; triangleOffset < node.data.w; ++triangleOffset) {
                const uint triangleIndex = node.data.z + triangleOffset;
                float distance;
                vec3 barycentric;
                ++localTriangleTests;
                if (intersectTriangle(origin, direction, triangles[triangleIndex], distance, barycentric) &&
                    distance < closestDistance) {
                    closestDistance = distance;
                    closestTriangle = triangleIndex;
                    closestBarycentric = barycentric;
                    hit = true;
                }
            }
            continue;
        }

        const uint leftIndex = node.data.x;
        const uint rightIndex = node.data.y;
        float leftNearDistance;
        float rightNearDistance;
        ++localNodeTests;
        const bool hitLeft = intersectBounds(origin, direction, nodes[leftIndex].boundsMinimum.xyz,
                                              nodes[leftIndex].boundsMaximum.xyz, closestDistance,
                                              leftNearDistance);
        ++localNodeTests;
        const bool hitRight = intersectBounds(origin, direction, nodes[rightIndex].boundsMinimum.xyz,
                                               nodes[rightIndex].boundsMaximum.xyz, closestDistance,
                                               rightNearDistance);
        if (hitLeft && hitRight) {
            // The fixed stack is safe because the CPU builder produces a balanced median-split tree.
            if (stackSize + 2 <= MAX_TRAVERSAL_STACK) {
                if (leftNearDistance < rightNearDistance) {
                    stack[stackSize++] = rightIndex;
                    nearStack[stackSize - 1] = rightNearDistance;
                    stack[stackSize++] = leftIndex;
                    nearStack[stackSize - 1] = leftNearDistance;
                } else {
                    stack[stackSize++] = leftIndex;
                    nearStack[stackSize - 1] = leftNearDistance;
                    stack[stackSize++] = rightIndex;
                    nearStack[stackSize - 1] = rightNearDistance;
                }
            }
        } else if (hitLeft && stackSize < MAX_TRAVERSAL_STACK) {
            stack[stackSize++] = leftIndex;
            nearStack[stackSize - 1] = leftNearDistance;
        } else if (hitRight && stackSize < MAX_TRAVERSAL_STACK) {
            stack[stackSize++] = rightIndex;
            nearStack[stackSize - 1] = rightNearDistance;
        }
    }

    vec3 color = backgroundColor(direction);
    if (hit) {
        const Triangle triangle = triangles[closestTriangle];
        vec3 normal = normalize(triangle.normal0.xyz * closestBarycentric.x +
                                triangle.normal1.xyz * closestBarycentric.y +
                                triangle.normal2.xyz * closestBarycentric.z);
        if (dot(normal, direction) > 0.0) {
            normal = -normal;
        }
        const vec3 lightDirection = normalize(vec3(-0.45, 0.82, -0.38));
        const float diffuse = max(dot(normal, lightDirection), 0.0);
        const float rim = pow(1.0 - max(dot(normal, -direction), 0.0), 2.0);
        color = vec3(0.72, 0.82, 0.91) * (0.2 + 0.75 * diffuse) + vec3(0.08, 0.12, 0.16) * rim;
    }

    atomicAdd(statistics.nodeTests, localNodeTests);
    atomicAdd(statistics.triangleTests, localTriangleTests);
    imageStore(outputImage, ivec2(pixel), vec4(color, 1.0));
}
